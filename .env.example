# ─────────────────────────────────────────────────────────────
# CureMindset — משתני סביבה (דוגמה)
# העתק לקובץ .env ומלא ערכים אמיתיים. אל תעלה .env ל-git.
# כל הערכים כאן הם PLACEHOLDER בלבד — אין לשמור סודות אמיתיים בקובץ הזה.
# ─────────────────────────────────────────────────────────────

# ── שרת ──
PORT=3000
# כתובת האתר הציבורית (לקישורי אימות, OAuth callback, sitemap)
SITE_URL=https://ketysegev.com
# נתיב קובץ ה-DB (ברירת מחדל: server/curemindset.db)
DB_FILE=server/curemindset.db

# ── פאנל ניהול (Admin) ──
# אין סיסמאות hardcoded בקוד — הן נקראות מכאן בלבד.
ADMIN_USER=changeme-admin-username
ADMIN_PASSWORD=changeme-strong-admin-password

# ── עוזר ה-AI (server-side בלבד — לעולם לא נחשף לדפדפן) ──
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o

# ── שליחת אימיילים (אימות, איפוס סיסמה, התראות) ──
# אופציה א': Gmail עם App Password (לא סיסמת החשבון הרגילה)
GMAIL_USER=your-account@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
# אופציה ב': Resend API (חלופה ל-Gmail)
RESEND_API_KEY=re_your_resend_key
# כתובת ממי נשלח / לאן נשלחות התראות מערכת
NOTIFICATION_FROM=CureMindset <no-reply@ketysegev.com>
NOTIFICATION_EMAIL=ketylive8@gmail.com

# ── SMS / OTP (Twilio — אימות טלפוני, אופציונלי) ──
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM=+1xxxxxxxxxx

# ── התחברות חברתית (OAuth — אופציונלי) ──
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# ── תשלום (Grow — מופעל רק בסיום trial, לא ב-MVP) ──
GROW_CHECKOUT_URL=https://pay.grow.link/your-checkout-id
GROW_WEBHOOK_SECRET=your-grow-webhook-signing-secret

# ── לידים / CRM (Make/n8n webhook — אופציונלי) ──
LEAD_WEBHOOK_URL=https://hook.eu2.make.com/your-webhook-id

# ── תוכן (RSS למאמרים — אופציונלי) ──
ARTICLES_RSS_URL=https://ketysegev.blogspot.com/feeds/posts/default

# ── דיבאג (השאר ריק ב-production) ──
# RESET_DEBUG=1  # חושף טוקן איפוס בתגובה — לפיתוח מקומי בלבד, לעולם לא ב-production
