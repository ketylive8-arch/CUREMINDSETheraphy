{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://curemindsetheraphy.onrender.com/api/$1" },
    { "source": "/uploads/(.*)", "destination": "https://curemindsetheraphy.onrender.com/uploads/$1" },
    { "source": "/workshops", "destination": "/index.html" },
    { "source": "/dashboard", "destination": "/index.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/emotional-coaching", "destination": "/emotional-coaching.html" },
    { "source": "/anxiety-and-stress", "destination": "/anxiety-and-stress.html" },
    { "source": "/self-confidence", "destination": "/self-confidence.html" },
    { "source": "/procrastination", "destination": "/procrastination.html" },
    { "source": "/cure-teens", "destination": "/cure-teens.html" },
    { "source": "/parents", "destination": "/parents.html" },
    { "source": "/method", "destination": "/method.html" },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/faq", "destination": "/faq.html" },
    { "source": "/contact", "destination": "/contact.html" },
    { "source": "/responsibility", "destination": "/responsibility.html" },
    { "source": "/accessibility", "destination": "/accessibility.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
